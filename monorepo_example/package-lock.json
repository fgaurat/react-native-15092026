{
  "name": "monorepo_example",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "monorepo_example",
      "version": "1.0.0",
      "license": "ISC",
      "workspaces": [
        "apps/*",
        "packages/*"
      ]
    },
    "apps/main_app": {
      "version": "1.0.0",
      "license": "ISC",
      "dependencies": {
        "@hello/shared": "*"
      }
    },
    "node_modules/@hello/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "node_modules/main_app": {
      "resolved": "apps/main_app",
      "link": true
    },
    "packages/shared": {
      "name": "@hello/shared",
      "version": "1.0.0",
      "license": "ISC"
    }
  }
}
